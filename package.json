{
  "name": "aura-fit-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:portable": "vite",
    "dev:full": "node scripts/start-full.mjs",
    "setup:agent": "node scripts/setup-agent.mjs",
    "build": "bash scripts/build-verified.sh",
    "build:portable": "vinext build && node scripts/validate-artifact.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:portable && node --test tests/rendered-html.test.mjs",
    "test:d1": "node scripts/test-d1.mjs",
    "test:auth": "node scripts/test-public-auth.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:d1 && npm run test:auth && npm run test:python",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "validate:portable": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "deploy:cloudflare": "npm run build:portable && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "displayName": "AURA FIT AI Training Coach"
}
